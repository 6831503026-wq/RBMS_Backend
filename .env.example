DB_HOST=localhost
DB_USER=rsms_user
DB_PASSWORD=your_database_password
DB_NAME=restaurant_storage

PORT=5001
PO_EMAIL=po@example.com
JWT_SECRET=replace_with_a_long_random_secret

# Optional login identifiers; defaults to demo_po and demo-kitchen.
USER_PO_LOGIN=user-po
USER_STAFF_LOGIN=user-staff
USER_PO_PASSWORD=change-me-po-password
USER_STAFF_PASSWORD=change-me-staff-password

# SMTP settings
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
GMAIL_APP_PASSWORD=your_gmail_app_password
MAIL_FROM=no-reply@example.com